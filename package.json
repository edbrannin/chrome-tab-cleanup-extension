{
  "name": "tab-cleanup-extension",
  "version": "0.0.0",
  "private": true,
  "description": "Tab Cleanup browser extension",
  "type": "module",
  "scripts": {
    "test": "vitest",
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "link-cleaner-js": "^1.1.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "vitest": "^5.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.1.5",
    "typescript": "^5.9.3",
    "web-ext": "^10.5.0",
    "wxt": "^0.21.3"
  }
}